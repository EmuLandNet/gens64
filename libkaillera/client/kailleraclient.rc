/* libkaillera client - dialogs. LGPL-2.1-or-later. */
#include <windows.h>
#include <commctrl.h>
#include "kcl_res.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_SERVERS DIALOGEX 0, 0, 380, 290
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Kaillera Client"
FONT 8, "MS Shell Dlg"
BEGIN
	CTEXT		"", IDC_STATUS, 4, 4, 372, 10
	CONTROL		"", IDC_TABS, WC_TABCONTROLA, WS_TABSTOP, 4, 16, 372, 232
	CONTROL		"", IDC_SERVERLIST, WC_LISTVIEWA, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 34, 360, 208
	CONTROL		"", IDC_WAITLIST, WC_LISTVIEWA, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 34, 360, 208
	AUTOCHECKBOX	"Play sound when someone joins my game", IDC_OPT_SOUND, 16, 40, 200, 10
	AUTOCHECKBOX	"Display join/quit messages", IDC_OPT_JOINMSG, 16, 56, 200, 10
	LTEXT		"Quit message", IDC_OPT_QUITLBL, 16, 76, 60, 10
	EDITTEXT	IDC_OPT_QUIT, 80, 74, 150, 12, ES_AUTOHSCROLL
	LTEXT		"Text code page (0 = system)", IDC_OPT_CSLBL, 16, 94, 100, 10
	EDITTEXT	IDC_OPT_CHARSET, 120, 92, 40, 12, ES_NUMBER
	LTEXT		"Username", IDC_NICKLBL, 6, 254, 36, 10
	EDITTEXT	IDC_NICK, 44, 252, 150, 12, ES_AUTOHSCROLL
	LTEXT		"Connection", IDC_CONNLBL, 204, 254, 40, 10
	COMBOBOX	IDC_CONN, 246, 252, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON	"Connect", IDOK, 120, 270, 50, 14
	PUSHBUTTON	"Refresh list", IDC_REFRESH, 174, 270, 50, 14
	PUSHBUTTON	"Enter IP...", IDC_ENTERIP, 228, 270, 46, 14
	PUSHBUTTON	"About...", IDC_ABOUT, 278, 270, 46, 14
	PUSHBUTTON	"Cancel", IDCANCEL, 328, 270, 48, 14
END

IDD_ENTERIP DIALOGEX 0, 0, 160, 66
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enter server address"
FONT 8, "MS Shell Dlg"
BEGIN
	LTEXT		"Server address (host or IP, port optional):\neg. gs.emu-land.net:27888", -1, 8, 6, 144, 18
	EDITTEXT	IDC_IP, 8, 28, 144, 12, ES_AUTOHSCROLL
	DEFPUSHBUTTON	"Connect", IDOK, 30, 46, 50, 14
	PUSHBUTTON	"Cancel", IDCANCEL, 84, 46, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 220, 110
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Shell Dlg"
BEGIN
	LTEXT		"", IDC_ABOUTTEXT, 8, 8, 204, 76
	DEFPUSHBUTTON	"OK", IDOK, 85, 90, 50, 14
END

IDD_LOBBY DIALOGEX 0, 0, 420, 300
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME
CAPTION "Kaillera"
FONT 8, "MS Shell Dlg"
BEGIN
	GROUPBOX	"Partyline", IDC_PARTYGRP, 4, 2, 412, 156
	CONTROL		"", IDC_CHATLOG, "RichEdit20A", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER, 10, 14, 250, 122
	CONTROL		"", IDC_USERS, WC_LISTVIEWA, LVS_REPORT | LVS_SINGLESEL | WS_BORDER, 264, 14, 146, 122
	LTEXT		"Chat:", IDC_CHATLBL, 10, 142, 20, 10
	EDITTEXT	IDC_CHATEDIT, 32, 140, 340, 12, ES_AUTOHSCROLL
	PUSHBUTTON	"Chat", IDC_CHATSEND, 376, 139, 34, 14
	GROUPBOX	"Current games", IDC_GAMESGRP, 4, 162, 412, 134
	CONTROL		"", IDC_GAMES, WC_LISTVIEWA, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 174, 400, 98
	PUSHBUTTON	"Join", IDC_JOIN, 10, 278, 50, 14
	PUSHBUTTON	"Create new game", IDC_CREATE, 64, 278, 70, 14
	/* the game room: shown instead of the game list, like in the original client */
	GROUPBOX	"New game", IDC_ROOMGRP, 4, 162, 412, 134, NOT WS_VISIBLE
	LTEXT		"", IDC_ROOMINFO, 10, 175, 260, 12, SS_SUNKEN | SS_LEFTNOWORDWRAP | SS_CENTERIMAGE | NOT WS_VISIBLE
	PUSHBUTTON	"Cancel", IDC_LEAVE, 290, 174, 56, 14, NOT WS_VISIBLE
	PUSHBUTTON	"Start game", IDC_START, 350, 174, 60, 14, NOT WS_VISIBLE
	GROUPBOX	"Current players", IDC_PLAYERSGRP, 10, 192, 400, 100, NOT WS_VISIBLE
	CONTROL		"", IDC_ROOMLOG, "RichEdit20A", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | NOT WS_VISIBLE, 16, 203, 170, 70
	EDITTEXT	IDC_ROOMEDIT, 16, 276, 132, 12, ES_AUTOHSCROLL | NOT WS_VISIBLE
	PUSHBUTTON	"Chat", IDC_ROOMSEND, 152, 275, 34, 14, NOT WS_VISIBLE
	CONTROL		"", IDC_PLAYERS, WC_LISTVIEWA, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | NOT WS_VISIBLE, 190, 203, 160, 86
	PUSHBUTTON	"Kick", IDC_KICK, 354, 203, 50, 14, NOT WS_VISIBLE
END

1 VERSIONINFO
FILEVERSION 0,9,0,1
PRODUCTVERSION 0,9,0,1
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Gens64 project"
			VALUE "FileDescription", "Kaillera netplay client (libkaillera)"
			VALUE "FileVersion", "0.9 (libkaillera)"
			VALUE "InternalName", "kailleraclient"
			VALUE "LegalCopyright", "LGPL 2.1 or later"
			VALUE "OriginalFilename", "kailleraclient.dll"
			VALUE "ProductName", "libkaillera"
			VALUE "ProductVersion", "0.9"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
